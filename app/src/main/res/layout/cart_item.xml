<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="12dp"
        android:padding="16dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <ImageView
                android:id="@+id/cart_image"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@tools:sample/avatars" />

            <TextView
                android:id="@+id/cart_food_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/yeon_sung"
                android:text="TextView"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@+id/cart_image"
                app:layout_constraintTop_toTopOf="@+id/cart_image" />

            <TextView
                android:id="@+id/cart_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/lato_bold"
                android:text="$7"
                android:textColor="@color/textColor"
                android:textSize="19sp"
                app:layout_constraintBottom_toBottomOf="@+id/cart_image"
                app:layout_constraintStart_toEndOf="@+id/cart_image" />

            <ImageButton
                android:id="@+id/cart_plus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/add_to_cart"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/plus" />

            <ImageButton
                android:id="@+id/cart_minus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/add_to_cart"
                android:padding="5dp"
                app:layout_constraintBottom_toBottomOf="@+id/cart_item_quantity"
                app:layout_constraintEnd_toStartOf="@+id/cart_item_quantity"
                app:layout_constraintTop_toTopOf="@+id/cart_item_quantity"
                app:srcCompat="@drawable/minus" />

            <TextView
                android:id="@+id/cart_item_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="1"
                app:layout_constraintBottom_toBottomOf="@+id/cart_plus"
                app:layout_constraintEnd_toStartOf="@+id/cart_plus"
                app:layout_constraintTop_toTopOf="@+id/cart_plus" />

            <ImageButton
                android:id="@+id/cart_remove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@android:color/transparent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/cart_plus"
                app:layout_constraintStart_toStartOf="@+id/cart_minus"
                app:layout_constraintTop_toBottomOf="@+id/cart_plus"
                app:srcCompat="@drawable/trash" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>